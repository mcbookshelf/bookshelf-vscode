name: Exhaustive Bookshelf documentation model
slug: bookshelf-exhaustive
version: 5.0.0
tags: runtime, datapack-only, exhaustive
description: Every construct the bsdoc grammar accepts, gathered in one document.

# a comment line, which may also end a statement
var shared_payload = storage bs.exhaustive:shared payload/levels : { levels: int } > a storage with a target and a path, reused below
var ^macro = macro : { raw: string } > a variable whose name is a keyword, escaped with '^'

feature function add_levels:
    description: Add levels to the player.
    authors: Aksiome, Leirof
    created: 2022/04/14 1.18.2
    updated: 2026/11/19 26.3

    input storage bs.exhaustive:add_levels in: {
        levels: int
        ^name: string
    } > a struct may spread over as many lines as it likes
    input macro : { command: string } > a macro always holds a struct
    input ref shared_payload > a reference may carry its own documentation
    input ref ^macro > or leave the one of the variable it points at

    context executor : entity > an executor takes an abstract entity
    context position : xyz > a position takes a position type
    context rotation : xy > a rotation takes a rotation type
    context dimension : overworld > a dimension takes a dimension type
    context state > a state carries no type at all
    context state # a trailing comment, where a '> doc' would otherwise be

    output success : number > a success takes a number
    output result : number > so does a result
    output storage : { levels: int } > an output storage holds a struct
    output state > ...

    var local_flag = storage : { done: boolean } > a variable declared inside a feature

feature predicate has_levels:
    authors: Aksiome
    created: 2023/01/02 1.19
    updated: 2023/12/31 1.20.4
    description: The fragments of a feature may come in any order.

    input storage bs.exhaustive:has_levels: {
        whole: int
        flag: boolean
        tiny: byte
        small: short
        big: long
        single: float
        wide: double
        text: string
        loose: number
        anything: any
    } > every primitive type a struct may hold

    input storage counters : {
        exact_size: int @ 0..100 [ ] @ 4
        max_size: long [ ] @ ..8
        min_size: byte @ 0..127 [ ] @ 1..
        full_size: byte [ ] @ 1..4
        flags: [ boolean ] @ 2
        rows: [ { cell: int } ] @ 1..3
        tree: { leaf: { depth: short } }
        either: int | string
        pair: [ int, string ]
        maybe?: boolean > an optional entry, documented
    } > arrays, lists, nested structs, unions, tuples, and all four range forms

    output success : number > ...

feature loot_table roll_levels:
    description: The remaining types a kind may be defined with.
    authors: Leirof
    created: 2024/02/29 1.20.4
    updated: 2024/02/29 1.20.4

    context executor : player > ...
    context position : entity > an abstract entity is also a position
    context rotation : player > and a rotation
    context dimension : nether > ...
    context dimension : end > ...
    context dimension : any > 'any' counts as a dimension too

    output result : number > ...

feature context_float_provider level_ratio:
    description: A registry holding underscores.
    authors: Aksiome
    created: 2025/06/01 1.21
    updated: 2025/06/01 1.21

    input storage: { ratio: double } > a storage with neither a target nor a path
    output success : number > ...

feature context_int_provider level_count:
    description: A feature whose identifier is a keyword.
    authors: Aksiome
    created: 2025/07/15 1.21.1
    updated: 2025/07/15 1.21.1

    input storage bs.exhaustive:level_count: { count: int } > a storage with a target only
    output result : number > ...

feature function_tag ^input:
    description: The last registry, and an escaped identifier.
    authors: Aksiome, Leirof
    created: 2026/09/13 26.3
    updated: 2026/09/13 26.3

    input storage path/only: { value: number } > a storage with a path only
    context state > ...
    output state > ...
