{
    "name": "bsdoc-language",
    "description": "The language specific package",
    "version": "0.0.1",
    "license": "MPL-2.0",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "test": "node test/parse.test.mjs && node test/validation.test.mjs && node test/completion.test.mjs && node test/highlight.test.mjs",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch"
    },
    "dependencies": {
        "chevrotain": "~11.0.3",
        "langium": "~4.4.0",
        "typir": "^0.3.3",
        "typir-langium": "^0.3.3",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "langium-cli": "~4.4.0"
    }
}
