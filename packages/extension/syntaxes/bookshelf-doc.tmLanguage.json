{
  "name": "bookshelf-doc",
  "scopeName": "source.bookshelf-doc",
  "fileTypes": ["bs"],
  "patterns": [
    { "include": "#struct" },
    { "include": "#comment" },
    { "include": "#property-line" },
    { "include": "#feature" },
    { "include": "#variable-declaration" },
    { "include": "#reference" },
    { "include": "#port" },
    { "include": "#documentation" },
    { "include": "#kind" },
    { "include": "#type-expression" },
    { "include": "#storage-target" },
    { "include": "#path" },
    { "include": "#identifier" }
  ],
  "repository": {
    "struct": {
      "comment": "a struct is a block: an entry inside it has the shape of a property line, but is not one",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.begin.bookshelf-doc" } },
      "endCaptures": { "0": { "name": "punctuation.section.struct.end.bookshelf-doc" } },
      "patterns": [
        { "include": "#struct" },
        { "include": "#comment" },
        { "include": "#documentation" },
        { "include": "#entry" },
        { "include": "#type-expression" },
        { "include": "#identifier" }
      ]
    },
    "comment": {
      "comment": "a '#' comment runs to the end of its line; after free text or a '> doc' it is part of them",
      "match": "#[^\\r\\n]*",
      "name": "comment.line.number-sign.bookshelf-doc"
    },
    "property-line": {
      "comment": "a document or feature property: any key, the rest of the line as free text",
      "match": "^\\s*(\\^?[A-Za-z_][A-Za-z0-9_-]*)(\\s*:)[ \\t]*([^\\r\\n]*)$",
      "captures": {
        "1": { "name": "keyword.other.field.bookshelf-doc" },
        "2": { "name": "punctuation.separator.key-value.bookshelf-doc" },
        "3": { "name": "string.unquoted.bookshelf-doc" }
      }
    },
    "feature": {
      "match": "^\\s*(feature)\\s+(function_tag|function|predicate|loot_table|context_float_provider|context_int_provider)\\s+([a-z_.-]+:[a-z_.-]+|\\^?[A-Za-z_][A-Za-z0-9_-]*)(\\s*:)",
      "captures": {
        "1": { "name": "keyword.control.feature.bookshelf-doc" },
        "2": { "name": "support.class.registry.bookshelf-doc" },
        "3": { "name": "entity.name.function.bookshelf-doc" },
        "4": { "name": "punctuation.section.feature.bookshelf-doc" }
      }
    },
    "variable-declaration": {
      "match": "^\\s*(var)\\s+(\\^?[A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.control.var.bookshelf-doc" },
        "2": { "name": "entity.name.variable.bookshelf-doc" },
        "3": { "name": "keyword.operator.assignment.bookshelf-doc" }
      }
    },
    "reference": {
      "match": "\\b(ref)\\b\\s*(\\^?[A-Za-z_][A-Za-z0-9_-]*)?",
      "captures": {
        "1": { "name": "keyword.control.ref.bookshelf-doc" },
        "2": { "name": "variable.other.readwrite.bookshelf-doc" }
      }
    },
    "port": {
      "match": "^\\s*(input|context|output)\\b",
      "captures": {
        "1": { "name": "keyword.control.port.bookshelf-doc" }
      }
    },
    "documentation": {
      "comment": "a '>' description runs to the end of its line",
      "match": "(>)([^\\r\\n]*)",
      "captures": {
        "1": { "name": "punctuation.definition.comment.bookshelf-doc" },
        "2": { "name": "comment.line.documentation.bookshelf-doc" }
      }
    },
    "kind": {
      "match": "\\b(storage|executor|rotation|position|dimension|state|result|success|macro)\\b",
      "name": "storage.type.kind.bookshelf-doc"
    },
    "entry": {
      "comment": "a struct entry name, optional or not, followed by its colon",
      "match": "(\\^?[A-Za-z_][A-Za-z0-9_-]*)(\\?)?(\\s*:)",
      "captures": {
        "1": { "name": "variable.other.property.bookshelf-doc" },
        "2": { "name": "keyword.operator.optional.bookshelf-doc" },
        "3": { "name": "punctuation.separator.key-value.bookshelf-doc" }
      }
    },
    "type-expression": {
      "comment": "everything a type is made of, inside a struct or after a kind",
      "patterns": [
        { "include": "#primitive-type" },
        { "include": "#number" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "primitive-type": {
      "match": "\\b(int|boolean|byte|short|long|float|double|string|number|any|player|entity|xyz|xy|overworld|nether|end)\\b",
      "name": "support.type.primitive.bookshelf-doc"
    },
    "storage-target": {
      "comment": "a resource location, whose path may be empty; the colon is part of it",
      "match": "\\b([a-z_.-]+)(:)([a-z_.-]*)",
      "captures": {
        "1": { "name": "entity.name.namespace.bookshelf-doc" },
        "2": { "name": "punctuation.separator.namespace.bookshelf-doc" },
        "3": { "name": "entity.name.label.bookshelf-doc" }
      }
    },
    "path": {
      "comment": "a storage path, followed by the colon which opens its type",
      "match": "(\\^?[A-Za-z_][A-Za-z0-9_-]*(?:/\\^?[A-Za-z_][A-Za-z0-9_-]*)*)(\\s*:)",
      "captures": {
        "1": { "name": "entity.name.label.bookshelf-doc" },
        "2": { "name": "punctuation.separator.key-value.bookshelf-doc" }
      }
    },
    "number": {
      "match": "(?:\\b[0-9]+)?\\.?[0-9]+\\b|\\b[0-9]+\\.(?![.])",
      "name": "constant.numeric.bookshelf-doc"
    },
    "operator": {
      "comment": "'..' builds a range, '@' attaches one, '|' joins a union",
      "match": "\\.\\.|@|\\|",
      "name": "keyword.operator.range.bookshelf-doc"
    },
    "punctuation": {
      "match": "[\\[\\]:,]",
      "name": "punctuation.separator.bookshelf-doc"
    },
    "identifier": {
      "match": "\\^?[A-Za-z_][A-Za-z0-9_-]*",
      "name": "variable.other.bookshelf-doc"
    }
  }
}
