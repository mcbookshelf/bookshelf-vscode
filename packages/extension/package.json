{
    "name": "vscode-bookshelf-doc",
    "description": "The extension specific package",
    "version": "0.0.1",
    "license": "MPL-2.0",
    "displayName": "Bookshelf",
    "publisher": "mcbookshelf",
    "icon": "images/icon.png",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "bookshelf-doc",
                "aliases": [
                    "Bookshelf",
                    "bookshelf-doc"
                ],
                "extensions": [
                    ".bs"
                ],
                "icon": {
                    "light": "./images/icon.png",
                    "dark": "./images/icon.png"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "bookshelf-doc",
                "scopeName": "source.bookshelf-doc",
                "path": "syntaxes/bookshelf-doc.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:bookshelf-doc"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "vscode:prepublish": "npm run build",
        "build": "tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "package": "npm run build && vsce package --allow-missing-repository",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "bookshelf-doc-language": "0.0.1",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "@vscode/vsce": "^3.9.2",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2"
    },
    "vsce": {
        "dependencies": false
    }
}
