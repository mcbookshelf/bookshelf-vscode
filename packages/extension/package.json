{
    "name": "vscode-bsdoc",
    "description": "The extension specific package",
    "version": "0.0.1",
    "license": "MPL-2.0",
    "displayName": "Bookshelf",
    "publisher": "mcbookshelf",
    "repository": {
        "type": "git",
        "url": "https://github.com/mcbookshelf/bookshelf-vscode.git"
    },
    "icon": "images/icon.png",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "bsdoc",
                "aliases": [
                    "Bookshelf",
                    "bsdoc"
                ],
                "extensions": [
                    ".bs"
                ],
                "icon": {
                    "light": "./images/icon.png",
                    "dark": "./images/icon.png"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "bsdoc",
                "scopeName": "source.bsdoc",
                "path": "syntaxes/bsdoc.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:bsdoc"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "vscode:prepublish": "npm run build",
        "build": "tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "package": "npm run build && vsce package --no-dependencies",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "bsdoc-language": "0.0.1",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "@vscode/vsce": "^3.9.2",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2"
    },
    "vsce": {
        "dependencies": false
    }
}
